# Security headers for every page
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Static images and assets (filenames are not versioned, so keep this to a week)
/img/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

# Keep the pages.dev hosts out of search results
https://groundapp.pages.dev/*
  X-Robots-Tag: noindex

https://:project.groundapp.pages.dev/*
  X-Robots-Tag: noindex
